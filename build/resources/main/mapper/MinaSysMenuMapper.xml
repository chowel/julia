<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.julia.mapper.MinaSysMenuMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.julia.entity.MinaSysMenuEntity">
        <id column="pact_id" property="pactId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="pact_name" property="pactName" />
        <result column="parent_id" property="parentId" />
        <result column="pact_type" property="pactType" />
        <result column="perms" property="perms" />
        <result column="url" property="url" />
        <result column="icon" property="icon" />
        <result column="sort" property="sort" />
        <result column="che_del" property="cheDel" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        pact_id, pact_name, parent_id, pact_type, perms, url, icon, sort, che_del
    </sql>


    <select id="getMenusByPowerId" resultType="com.julia.entity.MinaSysMenuEntity">
        SELECT
            pa.create_time,
            pa.update_time,
            pa.pact_id, pa.pact_name, pa.parent_id, pa.pact_type, pa.perms, pa.url, pa.sort, pa.icon, pa.che_del
        FROM
            mina_sys_menu AS pa
            INNER JOIN mina_sys_power_menu AS pop ON pa.pact_id = pop.pact_id
        WHERE
            pop.power_id = #{powerId}
    </select>

</mapper>

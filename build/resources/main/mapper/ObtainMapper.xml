<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.julia.mapper.ObtainMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.julia.entity.ObtainEntity">
        <id column="obtain_id" property="obtainId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="yao_id" property="yaoId" />
        <result column="name" property="name" />
        <result column="first_name" property="firstName" />
        <result column="last_name" property="lastName" />
        <result column="status" property="status" />
        <result column="cout" property="cout" />
        <result column="note" property="note" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        obtain_id, yao_id, name, first_name, last_name, status, cout, note
    </sql>

    <update id="coutEmpty">
        update obtain set cout = 0 where yao_id=#{id}
    </update>

</mapper>

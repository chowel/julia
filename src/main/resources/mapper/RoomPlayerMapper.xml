<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.julia.mapper.RoomPlayerMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.julia.entity.RoomPlayerEntity">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="room_id" property="roomId" />
        <result column="game_type" property="gameType" />
        <result column="init" property="init" />
        <result column="player_id" property="playerId" />
        <result column="nick_name" property="nickName" />
        <result column="online" property="online" />
        <result column="room_flag" property="roomFlag" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        id, room_id, game_type, init, player_id, nick_name, online, room_flag
    </sql>

</mapper>

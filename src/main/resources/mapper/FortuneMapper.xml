<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.julia.mapper.FortuneMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.julia.entity.FortuneEntity">
        <id column="fortune_id" property="fortuneId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="fortune_no" property="fortuneNo" />
        <result column="transact_no" property="transactNo" />
        <result column="order_id" property="orderId" />
        <result column="amount" property="amount" />
        <result column="pay_id" property="payId" />
        <result column="p_id" property="pId" />
        <result column="c_id" property="cId" />
        <result column="first_name" property="firstName" />
        <result column="last_name" property="lastName" />
        <result column="status" property="status" />
        <result column="check_callback" property="checkCallback" />
        <result column="done_time" property="doneTime" />
        <result column="handout_time" property="handoutTime" />
        <result column="msg" property="msg" />
        <result column="drawer" property="drawer" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        fortune_id, fortune_no, transact_no, order_id, amount, pay_id, p_id, c_id, first_name, last_name, status, check_callback, done_time, handout_time, msg, drawer
    </sql>
    <select id="metricsfortune" resultType="com.julia.entity.MetricsFortuneEntity">
        SELECT COUNT(*) as quantity,status,SUM(amount) as amount FROM fortune WHERE
        <if test="cid > 0">
            c_id = #{cid} AND
        </if>
        <if test="pid > 0">
            p_id = #{pid} AND
        </if>
        create_time BETWEEN #{st} AND #{et}
        GROUP  BY
        status
    </select>
</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.julia.mapper.GameMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.julia.entity.GameEntity">
        <id column="game_id" property="gameId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="game_no" property="gameNo" />
        <result column="room_id" property="roomId" />
        <result column="game_type" property="gameType" />
        <result column="status" property="status" />
        <result column="pokers" property="pokers" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        game_id, game_no, room_id, game_type, status, pokers
    </sql>

</mapper>
